{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": "../../../Target",
		"outDir": "../../../Target",
		"noCheck": true,
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"emitDeclarationOnly": false,
