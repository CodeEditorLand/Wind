{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"exactOptionalPropertyTypes": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"paths": {
			"@Function/*": ["../Common/TypeScript/Function/*"],
			"@codeeditorland/output/*": ["../Output/*"]
		},
		"plugins": [
			{
				"allowedDuplicatedPackages": [],
				"completions": true,
				"diagnosticSeverity": {
					"duplicatePackage": "error",
					"floatingEffect": "error",
					"leakingRequirements": "error",
					"missingEffectContext": "error",
					"missingEffectError": "error",
					"missingReturnYieldStar": "error",
					"missingStarInYieldEffectGen": "error",
					"unnecessaryEffectGen": "error",
					"unnecessaryPipe": "error"
				},
				"diagnostics": true,
				"name": "@effect/language-service",
				"quickinfo": true,
				"transform": "@effect/language-service/transform"
			}
		],
		"rootDir": "./Source",
		"skipLibCheck": true,
		"strict": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"target": "ESNext",
		"useDefineForClassFields": true,
		"composite": true
	},
	"exclude": [
		"Source/Effect/Language",
		"Source/Effect/WorkbenchCommand/Implementation",
		"Source/Bootstrap/Types",
		"Source/Effect/WorkbenchProgress/Implementation",
		"Source/Effect/WorkbenchLifecycle/Implementation",
		"Source/Effect/Storage/Implementation",
		"Source/Effect/WorkbenchActivity/Implementation",
		"Source/Effect/Panel/Layer",
		"Source/Codegen",
		"Source/Effect/StatusBar/Layer",
		"Source/Polyfill/Child/Process",
		"Source/Effect/Sidebar/Layer",
		"Source/Effect/WorkbenchDialog/Implementation",
		"Source/Function/Install/Function/ResolveConfiguration.ts",
		"Source/Effect/WorkbenchKeybinding/Implementation",
		"Source/Effect/WorkbenchWorkspace/Implementation",
		"Source/Effect/WorkbenchContextKey/Implementation",
		"Source/Effect/WorkbenchHost/Implementation",
		"Source/Workbench/Implementation/WorkbenchIntegrationImplementation.ts",
		"Source/Effect/TextFile",
		"Source/Effect/WorkbenchExtension/Implementation",
		"Source/Effect/Workspaces/Live.ts",
		"Source/Effect/WorkbenchStorage/Implementation",
		"Source/Effect/Terminal/Interface",
		"Source/Effect/Bootstrap",
		"Source/Effect/Telemetry/Layer",
		"Source/Effect/WorkbenchProduct/Implementation",
		"Source/Service/Tauri/Main/Process",
		"Source/Types/Interface/IPCRenderer.ts",
		"Source/Effect/UserSettings/Implementation/UserSettingsBridgeShapeGenerated.ts",
		"Source/Polyfill/File/System",
		"Source/Effect/NetworkRestrictions",
		"Source/Polyfill/Native/Module",
		"Source/Configuration/ESBuild",
		"Source/Service/TauriMainProcessService.ts",
		"Source/Effect/Sandbox/Layer",
		"node_modules",
		"Source/Effect/WorkbenchEditor/Implementation",
		"Source/Effect/Generated",
		"Source/Effect/Debug",
		"Source/Telemetry/PostHogBridge.ts",
		"Source/Effect/WorkbenchNotification/Implementation",
		"Source/Effect/Health/Implementation/HealthImplementation.ts",
		"Source/Polyfill/IPC/Renderer",
		"Source/Polyfill/File/Protocol",
		"Source/Effect/ActivityBar",
		"Target",
		"Source/Plugin/Transform/Replace/Product",
		"Source/Polyfill/Shared/Process",
		"Source/Effect/WorkbenchClipboard/Implementation"
	],
	"extends": "@playform/build/tsconfig",
	"include": ["Source"]
}
